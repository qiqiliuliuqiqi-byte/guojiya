# 电脑本机使用：复制为 config.env，默认即可。不要把此文件放入 js 目录。
HOST=127.0.0.1
PORT=8888
# 本地或私有部署的 Ollama 地址，末尾不要加 /api。
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3.5:9b-q4_K_M
# 若 Ollama 前方有带 Bearer Token 认证的网关，可在此填写；普通本地 Ollama 留空。
AI_TOKEN=
# 公网部署才填写以下项；PUBLIC_ORIGIN 必须为 HTTPS 域名。
PUBLIC_ORIGIN=
ACCESS_USER=student
ACCESS_PASSWORD=
